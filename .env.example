# ── Rounds ──────────────────────────────────────────────────────────────
# LLM for the agent (or connect a provider in Settings → Agent).
ANTHROPIC_API_KEY=

# Local: PGlite. Production: a hosted Postgres URL (e.g. Neon).
DATABASE_URL=pglite:./data/pglite

# Public https URL of this app (a tunnel locally). Used for reply links and
# the Telegram webhook.
PUBLIC_BASE_URL=https://your-tunnel-or-domain.example

# Dedicated Rounds bot from @BotFather (NOT the framework's Telegram chat).
ROUNDS_TELEGRAM_BOT_TOKEN=
ROUNDS_TELEGRAM_BOT_USERNAME=          # without @, for t.me deep links
ROUNDS_TELEGRAM_WEBHOOK_SECRET=        # 32+ chars, A-Z a-z 0-9 _ - only

# Demo pharmacies + the "Simulate a reply" dev panel.
DEMO_MODE=true
# agent = the agent reads replies (rules parser as 60 s fallback)
# rules = read every reply with the deterministic parser immediately
REPLY_PARSER=agent

# Auth: production needs a stable secret (BETTER_AUTH_URL is inferred).
# BETTER_AUTH_SECRET=
